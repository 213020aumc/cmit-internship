{
  "openapi": "3.0.0",
  "info": {
    "title": "Task Management API - Validation & Error Handling",
    "version": "1.0.0",
    "description": "Express 5 REST API with Joi schema validation, custom AppError operational/programming error distinction, and centralized global error handling."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Task CRUD operations with Joi validation"
    }
  ],
  "paths": {
    "/api/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get all tasks",
        "description": "Retrieve all tasks with an optional filter for completion status.",
        "parameters": [
          {
            "name": "completed",
            "in": "query",
            "required": false,
            "description": "Filter by completion status ('true' or 'false')",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            },
            "example": "true"
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a new task",
        "description": "Creates a task. Validated by Joi `createTaskSchema` (title: 3-100 characters, required).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskPayload"
              },
              "example": {
                "title": "Master Joi Validation in Express 5",
                "completed": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleTaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error (Missing title, shorter than 3 chars, etc.)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "fail",
                  "message": "Validation Error: Title must be at least 3 characters long"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "description": "Fetch a single task by its numeric ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the task",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleTaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID (must be a number)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "fail",
                  "message": "Invalid Task ID. Must be a number."
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "fail",
                  "message": "Task not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update an existing task",
        "description": "Update the title or completion status. Validated by Joi `updateTaskSchema`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the task to update",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskPayload"
              },
              "example": {
                "title": "Updated Task Title",
                "completed": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleTaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error or Invalid Task ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "fail",
                  "message": "Validation Error: Title must be at least 3 characters long"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "status": "fail",
                  "message": "Task not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "description": "Remove a task from the system by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numeric ID of the task to delete",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Task deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Task deleted successfully" },
                    "data": { "type": "null", "example": null }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID (must be a number)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Learn Express 5 Architecture" },
          "completed": { "type": "boolean", "example": false }
        },
        "required": ["id", "title", "completed"]
      },
      "CreateTaskPayload": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Task title (3-100 characters)",
            "example": "Master Joi Validation in Express 5"
          },
          "completed": {
            "type": "boolean",
            "description": "Initial task completion status",
            "example": false
          }
        }
      },
      "UpdateTaskPayload": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Updated task title",
            "example": "Updated Task Title"
          },
          "completed": {
            "type": "boolean",
            "description": "Updated completion status",
            "example": true
          }
        }
      },
      "TaskListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Tasks retrieved successfully" },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "SingleTaskResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Task retrieved successfully" },
          "data": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "fail" },
          "message": { "type": "string", "example": "Validation Error: Title must be at least 3 characters long" }
        }
      }
    }
  }
}
